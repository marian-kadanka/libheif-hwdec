#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DHWDEC_BUILD_TESTS=ON

# The tests labelled "gpu" compare against libde265 on a real GPU and would only be skipped in a
# build chroot, so only the unit tests run here.
# Which libheif releases load this build depends on the plugin API version CMake chose from the
# libheif headers (see HWDEC_PLUGIN_API in src/plugin.cc): libheif 1.21 and later refuse API
# versions below 5, and API 5 and 6 need the libheif release that introduced them.
HWDEC_PLUGIN_API = $(shell awk '/define HWDEC_PLUGIN_API /{print $$3}' obj-$(DEB_HOST_GNU_TYPE)/config.h 2>/dev/null)

override_dh_gencontrol:
	case "$(HWDEC_PLUGIN_API)" in \
	  3) depends="libheif1 (>= 1.15), libheif1 (<< 1.21)" ;; \
	  4) depends="libheif1 (>= 1.20), libheif1 (<< 1.21)" ;; \
	  5) depends="libheif1 (>= 1.21)" ;; \
	  6) depends="libheif1 (>= 1.22)" ;; \
	  *) echo "unknown plugin API version '$(HWDEC_PLUGIN_API)'" >&2; exit 1 ;; \
	esac; \
	dh_gencontrol -- "-Vhwdec:libheif=$$depends"

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cd obj-$(DEB_HOST_GNU_TYPE) && ctest --output-on-failure --label-exclude gpu
endif
